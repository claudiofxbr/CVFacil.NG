# CVFacil.NG - Environment Variables Example
# Copy this file to .env and fill in the values

# Database configuration (Neon)
DB_URL=jdbc:postgresql://ep-example-123.us-east-2.aws.neon.tech/cvfacil
DB_USERNAME=alexandre_dev
DB_PASSWORD=your_secure_password_here

# Security
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRATION=86400000

# App Root Credentials
ROOT_EMAIL=admin@cvfacil.com.br
ROOT_PASSWORD=your_secure_root_password_here

# Google OAuth2
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Gemini AI (importação de currículo via IA)
GEMINI_API_KEY=your_gemini_api_key_here

# CORS - origens do frontend permitidas em produção (separadas por vírgula)
# Em dev: http://localhost:3000,http://127.0.0.1:3000
# Em produção: https://cvfacil.xavierbr-vps.tech
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
